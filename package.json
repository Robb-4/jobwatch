{
  "name": "jobwatch",
  "version": "0.1.0",
  "private": true,
  "description": "Veille automatique d'offres d'emploi data — GitHub Actions + Supabase + GitHub Pages",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "task:fetch": "tsx src/tasks/fetch.ts",
    "task:report": "tsx src/tasks/report.ts",
    "task:purge": "tsx src/tasks/purge.ts",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "web:preview": "vite preview web"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "dotenv": "^16.4.5",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
