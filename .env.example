# Copier ce fichier en `.env` (ignoré par git) et y mettre les vraies valeurs.
# Ne jamais renseigner de secret ici : ce fichier est versionné.

# --- Supabase (tâches Actions : clé service_role, contourne RLS) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Sources ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=

# --- Mail (SMTP) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=jobwatch@example.com
MAIL_TO=moi@example.com

# --- Interface web (Vite n'expose au navigateur que les variables VITE_*) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Chemin de base du site Pages : /<nom-du-depot>/ (laisser / en local)
VITE_BASE_PATH=/
# owner/repo, pour le lien vers l'onglet Actions
VITE_GITHUB_REPO=
